{
  "name": "claude-trace-ui",
  "version": "0.1.0",
  "description": "Desktop application for viewing and browsing Claude Code session files",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/electron/preload.js --external:electron",
    "build:main": "esbuild electron/main.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/electron/main.js --external:electron --external:piscina",
    "dev:electron": "npm run build:preload && npm run build:main && concurrently \"vite\" \"wait-on http://localhost:5173 && env -u ELECTRON_RUN_AS_NODE electron .\"",
    "build": "tsc --noEmit && vite build && npm run build:main && npm run build:preload",
    "build:electron": "npm run build && electron-builder",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "analyze": "vite build --mode analyze"
  },
  "dependencies": {
    "dompurify": "^3.0.8",
    "highlight.js": "^11.9.0",
    "marked": "^11.1.1",
    "piscina": "^4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.10.6",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.27.0",
    "eslint": "^8.56.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.1",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "",
  "license": "MIT"
}
