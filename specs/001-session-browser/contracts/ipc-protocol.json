{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Electron IPC Protocol",
  "description": "Communication contract between main process and renderer process",
  "version": "1.0.0",

  "channels": {
    "session:scan": {
      "direction": "renderer → main",
      "description": "Request to scan for sessions in ~/.claude/projects",
      "request": {
        "type": "object",
        "properties": {
          "forceRescan": {
            "type": "boolean",
            "description": "Bypass cache and rescan filesystem",
            "default": false
          }
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "sessions": {
            "type": "array",
            "items": { "$ref": "#/definitions/SessionSummary" }
          },
          "scannedPaths": { "type": "number" },
          "duration": { "type": "number", "description": "Scan duration in ms" }
        },
        "required": ["sessions", "scannedPaths", "duration"]
      }
    },

    "session:load": {
      "direction": "renderer → main",
      "description": "Load full session details by UUID",
      "request": {
        "type": "object",
        "properties": {
          "uuid": { "type": "string", "format": "uuid" }
        },
        "required": ["uuid"]
      },
      "response": {
        "oneOf": [
          { "$ref": "#/definitions/Session" },
          { "$ref": "#/definitions/Error" }
        ]
      }
    },

    "session:export": {
      "direction": "renderer → main",
      "description": "Export session(s) as HTML",
      "request": {
        "type": "object",
        "properties": {
          "uuids": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" },
            "minItems": 1
          },
          "outputPath": {
            "type": "string",
            "description": "Directory to save exported files"
          },
          "options": {
            "type": "object",
            "properties": {
              "includeToolOutputs": { "type": "boolean", "default": true },
              "syntaxHighlighting": { "type": "boolean", "default": true },
              "embedStyles": { "type": "boolean", "default": true }
            }
          }
        },
        "required": ["uuids", "outputPath"]
      },
      "response": {
        "type": "object",
        "properties": {
          "exportedFiles": {
            "type": "array",
            "items": { "type": "string", "description": "Absolute file paths" }
          },
          "duration": { "type": "number" }
        }
      }
    },

    "session:parse": {
      "direction": "main → worker",
      "description": "Parse JSONL file in worker thread",
      "request": {
        "type": "object",
        "properties": {
          "filePath": { "type": "string" },
          "batchSize": { "type": "number", "default": 1000 }
        },
        "required": ["filePath"]
      },
      "response": {
        "oneOf": [
          { "$ref": "#/definitions/Session" },
          { "$ref": "#/definitions/Error" }
        ]
      }
    },

    "preferences:get": {
      "direction": "renderer → main",
      "description": "Get user preferences",
      "request": {
        "type": "object",
        "properties": {
          "key": { "type": "string" }
        }
      },
      "response": {
        "type": ["object", "null"],
        "description": "Preference value or null if not set"
      }
    },

    "preferences:set": {
      "direction": "renderer → main",
      "description": "Set user preference",
      "request": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "value": { "type": ["object", "string", "number", "boolean"] }
        },
        "required": ["key", "value"]
      },
      "response": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" }
        }
      }
    }
  },

  "definitions": {
    "SessionSummary": {
      "type": "object",
      "properties": {
        "uuid": { "type": "string", "format": "uuid" },
        "summary": { "type": "string", "maxLength": 200 },
        "projectName": { "type": "string" },
        "projectPath": { "type": "string" },
        "createdAt": { "type": "number", "description": "Unix timestamp ms" },
        "updatedAt": { "type": "number" },
        "messageCount": { "type": "number", "minimum": 0 },
        "totalTokens": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "description": "Session duration ms" }
      },
      "required": ["uuid", "summary", "projectName", "createdAt", "messageCount"]
    },

    "Session": {
      "type": "object",
      "description": "Full session object (see data-model.md)",
      "properties": {
        "uuid": { "type": "string" },
        "projectPath": { "type": "string" },
        "projectName": { "type": "string" },
        "summary": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "messageCount": { "type": "number" },
        "tokenUsage": { "$ref": "#/definitions/TokenUsage" },
        "events": {
          "type": "array",
          "items": { "$ref": "#/definitions/Event" }
        }
      },
      "required": ["uuid", "summary", "events"]
    },

    "TokenUsage": {
      "type": "object",
      "properties": {
        "input": { "type": "number", "minimum": 0 },
        "output": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 }
      },
      "required": ["input", "output", "total"]
    },

    "Event": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["summary", "user", "assistant", "tool_use", "tool_result", "file-history-snapshot", "system-reminder", "budget", "unknown"]
        },
        "timestamp": { "type": "number" },
        "data": { "type": "object" }
      },
      "required": ["type", "timestamp", "data"]
    },

    "Error": {
      "type": "object",
      "properties": {
        "error": { "type": "string" },
        "code": { "type": "string" },
        "details": { "type": "object" }
      },
      "required": ["error"]
    }
  }
}
